# Inconel Building - .gitignore

# Environment
.env
.env.*
!.env.example

# Vendor
/vendor/

# Writable directories
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
/writable/uploads/*

# Keep writable structure
!/writable/cache/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db
*.swp

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# PHP
*.phar
composer.lock

# Uploads
/public/uploads/*
!/public/uploads/.gitkeep
